/// Holder table for business KPIs and reliability/OEE measures; carries no data rows. Use its measures for analysis instead of writing formulas; do not query its columns.
table 'Business Measures'

	/// Total net sales revenue (USD), Sales[Amount] summed after discount. Use for revenue/sales totals. Not profit (cost not removed) and not quantity.
	measure 'Total Sales' = SUM(Sales[Amount])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Sales

	/// Total gross profit (USD) = revenue minus cost. Use for profit amounts. Not revenue, which ignores cost.
	measure 'Total Profit' = SUM(Sales[Profit])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Sales

	/// Gross profit as a percent of revenue (profit / sales). Use for margin %. A rate, not the Total Profit currency amount.
	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales

	/// Total units sold (count), Sales[Qty] summed. Use for sales volume. Not revenue (currency) and not produced units.
	measure 'Total Sales Qty' = SUM(Sales[Qty])
		formatString: #,0
		displayFolder: Sales

	/// Average realized price per unit sold (USD) = revenue / units sold. Use for effective price. Not the list Price column, not total revenue.
	measure 'Average Selling Price' = DIVIDE([Total Sales], [Total Sales Qty])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Sales

	/// Year-to-date sales revenue (USD), accumulated Jan 1 to context date. Use for YTD revenue. Period-to-date, not full-year Total Sales.
	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Date'[Date])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Sales\Time Intelligence

	/// Year-to-date gross profit (USD), accumulated Jan 1 to context date. Use for YTD profit. Period-to-date; not Sales YTD (revenue).
	measure 'Profit YTD' = TOTALYTD([Total Profit], 'Date'[Date])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Sales\Time Intelligence

	/// On-hand inventory units (count), Inventory[Qty] summed. Use for current stock levels. On-hand only; not in-transit, not produced/sold.
	measure 'Total Inventory Qty' = SUM(Inventory[Qty])
		formatString: #,0
		displayFolder: Inventory

	/// Total shortfall units (count): for rows below reorder point, sum of (reorder - on-hand). Use to size restock. A quantity, not a row count.
	measure 'Inventory Below Reorder Qty' = SUMX(FILTER(Inventory, Inventory[Qty] < Inventory[Reorder]), Inventory[Reorder] - Inventory[Qty])
		formatString: #,0
		displayFolder: Inventory

	/// Count of product-plant-date snapshots where on-hand is below reorder point. Use for how many items at risk. A case count, not the shortfall quantity.
	measure 'Inventory Risk SKU Count' = COUNTROWS(FILTER(SUMMARIZE(Inventory, Inventory[Date], Inventory[Product], Inventory[Plant], "Qty", SUM(Inventory[Qty]), "Reorder", SUM(Inventory[Reorder])), [Qty] < [Reorder]))
		formatString: #,0
		displayFolder: Inventory

	/// Total purchase-order spend (USD). Use for procurement/buying value. Spend on goods we buy, not sales revenue.
	measure 'Purchase Order Amount' = SUM(PurchaseOrders[Amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Procurement

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Number of purchase-order lines (count). Use for how many POs. A row count, not spend (currency) and not units ordered.
	measure 'PO Count' = COUNTROWS(PurchaseOrders)
		formatString: #,0
		displayFolder: Procurement

	/// Count of PO lines delivered on time (OnTime = true). Use for number of on-time POs. A count, not a rate; numerator of On Time PO Rate.
	measure 'On Time PO Count' = CALCULATE(COUNTROWS(PurchaseOrders), PurchaseOrders[OnTime] = TRUE())
		formatString: #,0
		displayFolder: Procurement

	/// Share of PO lines delivered on time = on-time / all POs (%). Use for supplier on-time-delivery rate. A rate, not the on-time count.
	measure 'On Time PO Rate' = DIVIDE([On Time PO Count], [PO Count])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Procurement

	/// Average delivery delay in days = actual minus promised lead time, averaged over POs. Positive = late. Use for supplier lateness. Days, not a count or rate.
	measure 'Average Supplier Delay Days' = AVERAGEX(PurchaseOrders, PurchaseOrders[ActualDays] - PurchaseOrders[PromisedDays])
		formatString: 0.00
		displayFolder: Procurement

	/// Total produced units (count) = good plus scrap. Use for output/production volume. Produced units, not sold units, not good-only.
	measure 'Production Qty' = SUM(ProductionLog[Qty])
		formatString: #,0
		displayFolder: Production

	/// Total good (non-scrap) units produced (count). Use for good output. Excludes scrap; not total produced, not sold.
	measure 'Good Units' = SUM(ProductionLog[Good])
		formatString: #,0
		displayFolder: Production

	/// Total scrapped/failed units produced (count). Use for scrap volume. A count of bad units, not the scrap rate (%).
	measure 'Scrap Units' = SUM(ProductionLog[Scrap])
		formatString: #,0
		displayFolder: Production

	/// Good units as a percent of produced (good / produced). Use for yield %. A rate, not a unit count; complement of scrap rate.
	measure 'Production Yield %' = DIVIDE([Good Units], [Production Qty])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production

	/// Scrapped units as a percent of produced (scrap / produced). Use for scrap rate %. A rate, not the scrap unit count. RQX
	measure 'Scrap Rate %' = DIVIDE([Scrap Units], [Production Qty])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production

	/// Total machine runtime in minutes. Use for run/uptime minutes. Minutes of running, not downtime; not a percentage.
	measure 'Runtime Minutes' = SUM(ProductionLog[Runtime])
		formatString: #,0
		displayFolder: Production

	/// Total machine downtime in minutes. Use for stoppage duration. Minutes of stoppage, not runtime; not Downtime %.
	measure 'Downtime Minutes' = SUM(ProductionLog[Down])
		formatString: #,0
		displayFolder: Production

	/// Downtime as a percent of total time = downtime / (runtime + downtime). Use for share of time stopped. A rate, not downtime minutes.
	measure 'Downtime %' = DIVIDE([Downtime Minutes], [Runtime Minutes] + [Downtime Minutes])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production

	/// Produced as a percent of planned (actual / planned). Use for schedule attainment %. A rate, not a unit count; not yield.
	measure 'Schedule Attainment %' = DIVIDE(SUM(ProductionLog[Qty]), SUM(ProductionLog[Planned]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production

	/// TP or tp sales. Sales amount for Turbines and Pumps only. For any questions related to TP or TP use this measure. TP = Turbine & Pump only. 
	measure sls_amt_x =
			// Sales amount for Turbines and Pumps only.
			CALCULATE([Total Sales], Products[Category] IN { "Turbines", "Pumps" })
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Ambiguous Names Demo

	measure gm2_pct =
			// Gross margin percentage excluding Spare Parts.
			DIVIDE(
			    CALCULATE([Total Profit], Products[Category] <> "Spare Parts"),
			    CALCULATE([Total Sales], Products[Category] <> "Spare Parts")
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ambiguous Names Demo

	measure po_ok_flagish =
			// On-time purchase order count divided by high-value purchase order count.
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(PurchaseOrders),
			        PurchaseOrders[OnTime] = TRUE(),
			        PurchaseOrders[ActualDays] <= PurchaseOrders[PromisedDays]
			    ),
			    CALCULATE(COUNTROWS(PurchaseOrders), PurchaseOrders[Amount] >= 100000)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ambiguous Names Demo

	/// Day Production Yield (DPY). day yield pct = Production yield excluding Night shift. Use if the user asks about Day production yield
	measure 'Day Yield Pct' =
			// Production yield excluding Night shift.
			DIVIDE(
			    SUMX(FILTER(ProductionLog, ProductionLog[Shift] <> "Night"), ProductionLog[Good]),
			    SUMX(FILTER(ProductionLog, ProductionLog[Shift] <> "Night"), ProductionLog[Qty])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ambiguous Names Demo

	measure inv_rsk_u =
			// Unresolved inventory shortfall after considering in-transit quantity.
			SUMX(
			    FILTER(
			        Inventory,
			        Inventory[Qty] < Inventory[Reorder]
			            && Inventory[InTransit] < (Inventory[Reorder] - Inventory[Qty])
			    ),
			    Inventory[Reorder] - Inventory[Qty] - Inventory[InTransit]
			)
		formatString: #,0
		displayFolder: Ambiguous Names Demo

	/// Equipment availability = runtime / (runtime + downtime) (%). OEE time component. A rate; complement of Downtime %.
	measure 'Availability %' = DIVIDE([Runtime Minutes], [Runtime Minutes] + [Downtime Minutes])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Reliability

	/// Performance = produced / planned (%), the OEE speed component. A rate; mirrors Schedule Attainment as an OEE factor.
	measure 'Performance %' = DIVIDE([Production Qty], SUM(ProductionLog[Planned]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Reliability

	/// Quality = good / produced (%), the OEE quality component. A rate; same value as Production Yield, used in OEE.
	measure 'Quality %' = DIVIDE([Good Units], [Production Qty])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Reliability

	/// Overall Equipment Effectiveness = Availability x Performance x Quality (%). A composite rate, not any single component.
	measure 'OEE %' = [Availability %] * [Performance %] * [Quality %]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Reliability

	/// Produced units (count) for the same period one year earlier, period-aligned. Use as prior-year baseline. Prior year, not current Production Qty.
	measure 'Production Qty PY' = CALCULATE([Production Qty], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0
		displayFolder: Production\Time Intelligence

	/// Period-aligned year-over-year change in produced units = (this yr - prior) / prior (%). Avoids partial-vs-full-year. A rate.
	measure 'Production Qty YoY %' = DIVIDE([Production Qty] - [Production Qty PY], [Production Qty PY])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production\Time Intelligence

	/// Year-to-date produced units (count), accumulated Jan 1 to context date. Use for YTD production. Period-to-date, not full-year.
	measure 'Production Qty YTD' = TOTALYTD([Production Qty], 'Date'[Date])
		formatString: #,0
		displayFolder: Production\Time Intelligence

	/// Good units (count) for the same period one year earlier, period-aligned. Prior-year baseline for good-units YoY. Not current Good Units.
	measure 'Good Units PY' = CALCULATE([Good Units], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0
		displayFolder: Production\Time Intelligence

	/// Period-aligned year-over-year change in good units = (this yr - prior) / prior (%). Use for good-units YoY. A rate, not a unit count.
	measure 'Good Units YoY %' = DIVIDE([Good Units] - [Good Units PY], [Good Units PY])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Production\Time Intelligence

	/// Hidden placeholder for this measures-only table; carries no data. Ignore; use the table's measures.
	column Value
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Business Measures' = calculated
		mode: import
		source = ROW("Value", 0)

